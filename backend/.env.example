# Optional local overrides. Copy to backend/.env.local for preview:account.
# That file is ignored by Git. Java/Gradle alone does not load it automatically.
# Never prefix server secrets with VITE_.
JIBRO_APP_ORIGIN=http://127.0.0.1:5173
JIBRO_TEST_LOGIN_ENABLED=true
# Local default: persistent H2 database and generated key in backend/.local-data/.
# JIBRO_DATABASE_URL=jdbc:h2:file:./.local-data/members;MODE=PostgreSQL;DATABASE_TO_LOWER=TRUE
# JIBRO_NOTEBOOK_KEY_FILE=./.local-data/notebook-keys.json

# Optional email delivery (set real values securely, never commit them):
# JIBRO_RESEND_API_KEY=
# JIBRO_MAIL_FROM=account@your-verified-domain.example

# Production deployment only, inject through the host's secret manager:
# SPRING_PROFILES_ACTIVE=prod
# JIBRO_APP_ORIGIN=https://your-app.example
# JIBRO_DATABASE_URL=jdbc:postgresql://database-host:5432/jibro
# JIBRO_DATABASE_USER=
# JIBRO_DATABASE_PASSWORD=
# JIBRO_NOTEBOOK_KEYS={"active":"key-id","keys":{"key-id":"base64url-32-random-bytes"}}
# Keep database TLS parameters appropriate for the chosen host.
