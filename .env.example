# Leave values empty to use local records and committed notice snapshots.
VITE_API_BASE=

# Optional collector/import API; local preparation records stay in the browser.
# Example: http://localhost:8080
VITE_NOTICES_API_BASE=

# Optional deployed Spring API for fresh PDF/HWPX excerpts.
# Example: http://localhost:8080
VITE_NOTICE_EVIDENCE_API_BASE=
