# Leave values empty to use committed notice snapshots.
# Member login/storage always use the same-origin Worker, not these URLs.
# Run npm run preview:account to test accounts locally.
# Legacy fallback for notice APIs only; prefer the dedicated variables below.
VITE_API_BASE=

# Optional collector/import API; independent from member storage.
# Example: http://localhost:8080
VITE_NOTICES_API_BASE=

# Optional deployed Spring API for fresh PDF/HWPX excerpts.
# Example: http://localhost:8080
VITE_NOTICE_EVIDENCE_API_BASE=

# Server runtime only (configure in Sites, never expose with VITE_ prefix).
# JIBRO_RESEND_API_KEY=<secret with sending access>
# JIBRO_MAIL_FROM=account@your-verified-domain.example
